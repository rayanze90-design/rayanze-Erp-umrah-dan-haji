{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@erp/shared": ["packages/shared/src/index.ts"],
      "@erp/ui": ["packages/ui/src/index.ts"],
      "@/*": ["apps/web/*"]
    }
  }
}
